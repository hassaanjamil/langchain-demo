{
  // Python-specific formatting and import organization on save
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit"
    }
  },

  // Black formatter extension configuration
  "black-formatter.args": ["--line-length=100", "--target-version=py310"],

  // isort extension configuration for import sorting
  "isort.args": ["--profile=black", "--line-length=100"],

  // General editor settings
  "editor.rulers": [100],
  "editor.trimAutoWhitespace": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
